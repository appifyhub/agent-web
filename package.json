{
  "name": "agent-web",
  "private": true,
  "version": "5.31.2",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .vite node_modules/.vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "rebuild": "bun run clean && bun run build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "bun run lint:i18n && bun run lint:code && bun run lint:css",
    "lint:code": "eslint .",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "lint:i18n": "bun run i18n:keys && bun run i18n:check",
    "i18n:keys": "bun scripts/generate-translation-keys.ts",
    "i18n:check": "bun scripts/check-translation-usage.ts",
    "bump": "bun scripts/bump-version.ts",
    "create_pr": "bun scripts/create-pr.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.30.0",
    "make-plural": "^8.1.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "postcss-custom-media": "^12.0.1",
    "postcss-custom-properties": "^15.0.1",
    "postcss-custom-selectors": "^9.0.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.1",
    "postcss-theme-ui": "^0.10.0",
    "shadcn": "^4.16.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  }
}
